# Normalise line endings: the repo is committed from Windows and cloned on Linux (CI, other machines).
* text=auto eol=lf

# Shell entry points must stay LF or bash refuses them ("\r: command not found").
*.sh text eol=lf
kit/gradlew text eol=lf
# Windows batch files must stay CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries.
*.jar binary
*.webp binary
*.png binary
*.ttf binary
*.apk binary
